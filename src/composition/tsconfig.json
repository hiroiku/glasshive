// 合成の根。**層をまたいで import してよいのはここだけである。**
// ここだけが、どのポートにどの実装が入るかを知っている。
// `frameworks` は見ない — `frameworks` がこちらを使う側なので、見ると循環参照になる。
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": "../../dist/types/composition",
    "tsBuildInfoFile": "../../dist/types/composition.tsbuildinfo",
    "rootDir": ".",
    "paths": {
      "~/composition/*": ["./*"],
      "~/app-kernel/*": ["../app-kernel/*"],
      "~/domain/*": ["../domain/*"],
      "~/application/*": ["../application/*"],
      "~/interface/*": ["../interface/*"],
      "~/infrastructure/*": ["../infrastructure/*"]
    }
  },
  "include": ["."],
  "references": [
    {
      "path": "../app-kernel"
    },
    {
      "path": "../domain"
    },
    {
      "path": "../application"
    },
    {
      "path": "../interface"
    },
    {
      "path": "../infrastructure"
    }
  ]
}
