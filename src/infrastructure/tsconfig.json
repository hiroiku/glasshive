// infrastructure は application が宣言したポートを実装する。**`domain` は `import` できない。**
// パースは domain の仕事で、ここは外の世界から素材を持ってくるだけである。
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": "../../dist/types/infrastructure",
    "tsBuildInfoFile": "../../dist/types/infrastructure.tsbuildinfo",
    "rootDir": ".",
    "paths": {
      "~/infrastructure/*": ["./*"],
      "~/app-kernel/*": ["../app-kernel/*"],
      "~/application/*": ["../application/*"]
    }
  },
  "include": ["."],
  "references": [
    {
      "path": "../app-kernel"
    },
    {
      "path": "../application"
    }
  ]
}
