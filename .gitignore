# 依存。**錠は package-lock.json 1 本だけ持つ** —
# 2 本あると、どちらを直したかで入る版が分かれる。bun でも同じ錠を読ませる。
node_modules/
bun.lock
bun.lockb

# ビルド成果物
dist/
.output/
*.tsbuildinfo

# ルーターの生成物(dev / build で作り直される)
src/frameworks/tanstack/routeTree.gen.ts

# テスト
coverage/

# ローカル設定
.env
.env.*.local
*.local

# OS / エディター
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# 旧実装。読むためだけに置いてある参考資料で、履歴を持たない。
# 移植を終えたらディレクトリごと消す。
old/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# ブラウザーで確かめたときの写し
.playwright-mcp/
