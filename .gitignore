# 依存。**錠は package-lock.json 1 本だけ持つ** —
# 2 本あると、どちらを直したかで入る版が分かれる。bun でも同じ錠を読ませる。
node_modules/
bun.lock
bun.lockb

# ビルド成果物
dist/
.output/
.tanstack/
*.tsbuildinfo

# 取り込んだパッケージのライセンス表示。ビルドがバンドルの中身から書き出すので、
# git に入れると依存を足した日に古いままの写しが残る
THIRD-PARTY-NOTICES.md

# ルーターの生成物(dev / build で作り直される)
src/frameworks/tanstack/routeTree.gen.ts

# テスト
coverage/

# ローカル設定
.env
.env.*.local
*.local
# 機械ごとの許可設定。`.claude/settings.json` は共有するが、こちらは共有しない
.claude/settings.local.json

# OS / エディター
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# 旧実装。読むためだけに置いてある参考資料で、履歴を持たない。
# 移植を終えたらディレクトリごと消す。
old/

# ブラウザーで確かめたときの写し
.playwright-mcp/

# 作業場所。枝ごとに切り出して使う
.worktrees/
